# Locates (or downloads) the Microsoft.Web.WebView2 NuGet package.
#
# We only need two things from it:
#   * build/native/include/WebView2.h  (plain COM headers, usable from MinGW-w64 and MSVC)
#   * WebView2Loader.dll               (loaded at runtime with LoadLibrary, so NO import
#                                       library and NO MSVC-specific static lib is needed)

if(NOT WEBVIEW2_SDK_DIR)
  set(_wv2_dir "${CMAKE_BINARY_DIR}/_deps/webview2-${WEBVIEW2_VERSION}")
  if(NOT EXISTS "${_wv2_dir}/build/native/include/WebView2.h")
    set(_wv2_zip "${CMAKE_BINARY_DIR}/_deps/webview2-${WEBVIEW2_VERSION}.zip")
    message(STATUS "Downloading Microsoft.Web.WebView2 ${WEBVIEW2_VERSION} from nuget.org ...")
    file(DOWNLOAD
      "https://www.nuget.org/api/v2/package/Microsoft.Web.WebView2/${WEBVIEW2_VERSION}"
      "${_wv2_zip}" TLS_VERIFY ON STATUS _wv2_status)
    list(GET _wv2_status 0 _wv2_code)
    if(NOT _wv2_code EQUAL 0)
      file(REMOVE "${_wv2_zip}")
      message(FATAL_ERROR
        "Could not download the WebView2 SDK (${_wv2_status}).\n"
        "Offline? Download https://www.nuget.org/packages/Microsoft.Web.WebView2 (\"Download package\"),\n"
        "rename .nupkg to .zip, extract it, and configure with -DWEBVIEW2_SDK_DIR=<extracted folder>.")
    endif()
    file(ARCHIVE_EXTRACT INPUT "${_wv2_zip}" DESTINATION "${_wv2_dir}")
  endif()
  set(WEBVIEW2_SDK_DIR "${_wv2_dir}")
endif()

set(WEBVIEW2_INCLUDE_DIR "${WEBVIEW2_SDK_DIR}/build/native/include")
if(NOT EXISTS "${WEBVIEW2_INCLUDE_DIR}/WebView2.h")
  message(FATAL_ERROR "WebView2.h not found under ${WEBVIEW2_INCLUDE_DIR}. Check WEBVIEW2_SDK_DIR.")
endif()

foreach(_cand
    "${WEBVIEW2_SDK_DIR}/build/native/x64/WebView2Loader.dll"
    "${WEBVIEW2_SDK_DIR}/runtimes/win-x64/native/WebView2Loader.dll")
  if(EXISTS "${_cand}")
    set(WEBVIEW2_LOADER_DLL "${_cand}")
    break()
  endif()
endforeach()
if(NOT WEBVIEW2_LOADER_DLL)
  message(FATAL_ERROR "WebView2Loader.dll (x64) not found in the WebView2 package.")
endif()
message(STATUS "WebView2 SDK:   ${WEBVIEW2_SDK_DIR}")

# ---------------------------------------------------------------------------
# Interface IDs for QueryInterface.
# MinGW has no reliable __uuidof for these and WebView2.h only *declares* the IID symbols, so we read
# the GUIDs straight out of the SDK header and generate a small header with plain GUID constants.
# ---------------------------------------------------------------------------
file(READ "${WEBVIEW2_INCLUDE_DIR}/WebView2.h" _wv2_header)

function(hb_wv2_iid iface required)
  # CMake exposes at most 9 regex groups, so the last two GUID blocks are captured whole and split below.
  string(REGEX MATCH
    "MIDL_INTERFACE\\(\"([0-9a-fA-F]+)-([0-9a-fA-F]+)-([0-9a-fA-F]+)-([0-9a-fA-F]+)-([0-9a-fA-F]+)\"\\)[ \t\r\n]*${iface}[ \t\r\n]*:"
    _m "${_wv2_header}")
  if(NOT _m)
    if(required)
      message(FATAL_ERROR "Interface ${iface} not found in WebView2.h. Use a newer WEBVIEW2_VERSION.")
    endif()
    return()
  endif()
  set(_d1 "${CMAKE_MATCH_1}")
  set(_d2 "${CMAKE_MATCH_2}")
  set(_d3 "${CMAKE_MATCH_3}")
  set(_d4 "${CMAKE_MATCH_4}")
  set(_d5 "${CMAKE_MATCH_5}")
  set(_bytes "")
  foreach(_blk "${_d4}" "${_d5}")
    string(LENGTH "${_blk}" _len)
    math(EXPR _last "${_len} - 2")
    foreach(_i RANGE 0 ${_last} 2)
      string(SUBSTRING "${_blk}" ${_i} 2 _byte)
      list(APPEND _bytes "0x${_byte}")
    endforeach()
  endforeach()
  list(LENGTH _bytes _n)
  if(NOT _n EQUAL 8)
    message(FATAL_ERROR "Unexpected GUID format for ${iface} in WebView2.h")
  endif()
  string(REPLACE ";" "," _bytes_csv "${_bytes}")
  set(_g "{0x${_d1},0x${_d2},0x${_d3},{${_bytes_csv}}}")
  string(TOUPPER "${_g}" _g)
  string(REPLACE "0X" "0x" _g "${_g}")
  set(_wv2_iid_text "${_wv2_iid_text}static const GUID HB_IID_${iface} = ${_g};\n#define HB_HAVE_${iface} 1\n" PARENT_SCOPE)
endfunction()

set(_wv2_iid_text "// Generated by cmake/WebView2.cmake - do not edit.\n#pragma once\n#include <guiddef.h>\n")
hb_wv2_iid(ICoreWebView2_3 TRUE)    # TrySuspend / Resume
hb_wv2_iid(ICoreWebView2_8 TRUE)    # IsDocumentPlayingAudio (never sleep a tab that is playing audio)
hb_wv2_iid(ICoreWebView2_19 FALSE)  # MemoryUsageTargetLevel (optional, newer SDKs)
file(WRITE "${CMAKE_BINARY_DIR}/generated/WebView2Iids.h" "${_wv2_iid_text}")
set(WEBVIEW2_GENERATED_DIR "${CMAKE_BINARY_DIR}/generated")
